# mkdocs build output (deployed via gh-pages branch)
/site/

# docs-site/public/demo/ — derived, not source. docs-site/scripts/sync-docs.mjs
# (copyDemoAssets) recopies every tracked docs/demo asset into it on each build,
# so tracking the copies duplicated ~3 MB of binaries in the tree.
docs-site/public/demo/


# research artifacts (LLM briefs and traces). Moved to archive/research/ on
# 2026-09-07: they are working notes, not part of the published project.
/research/


# local operator credentials (never commit)
/_space_write_token_*.txt

# internal notes: audit reports, session handoffs, agent scratch.
# Two layers keep these out of anything published:
#   1. here — they cannot enter the git index by accident;
#   2. scripts/check_repo_hygiene.py — CI fails if one is tracked anyway.
