{
  "name": "ab-test-research-designer-frontend",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:types": "python ../../scripts/generate_frontend_api_types.py",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "python ../../scripts/run_local_smoke.py",
    "test:e2e": "python ../../scripts/run_frontend_e2e.py",
    "test:e2e:install": "playwright install chromium",
    "lint": "node eslint-toolchain/run-lint.mjs",
    "lint:install": "npm --prefix eslint-toolchain ci"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
