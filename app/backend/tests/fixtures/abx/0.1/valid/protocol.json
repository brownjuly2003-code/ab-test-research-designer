    "effect_measure": "risk_difference",
    "horizon": "P7D",
    "missing_data_rule": "zero"
  },
  "design": {
    "experiment_type": "randomized",
    "interference_assumption": "no_interference",
    "exposure_semantics": "The first valid assignment followed by a checkout page view is the exposure."
  },
  "analysis": {
    "method": {"method_id": "newcombe", "method_version": "1"},
