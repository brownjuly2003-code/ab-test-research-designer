    "randomization_unit": "user",
    "analysis_population": "intention_to_treat",
    "exclusions": ["internal traffic", "invalid assignment identity"]
  },
  "interventions": [
    {
      "intervention_id": "control",
      "label": "Current checkout copy",
      "kind": "control",
      "allocation": "0.5",
      "namespace": "checkout",
      "hash_version": "assignment_v1"
    },
    {
      "intervention_id": "treatment",
      "label": "Short checkout copy",
      "kind": "treatment",
      "allocation": "0.5",
      "namespace": "checkout",
      "hash_version": "assignment_v1"
    }
  ],
  "metrics": {
    "primary": [
      {
        "metric_id": "metric_conversion",
        "metric_version": "v1",
        "definition_digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
      }
    ],
    "secondary": [],
    "guardrails": [
      {
        "metric_id": "metric_refund",
        "metric_version": "v1",
        "definition_digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
      }
    ]
  },
  "estimand": {
    "estimand_id": "estimand_conversion_itt",
